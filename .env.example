# Copie este arquivo para .env e preencha com as credenciais reais.
# O arquivo .env esta no .gitignore e NUNCA deve ser commitado.
# Mantenha os valores de producao VAZIOS aqui: este arquivo e versionado.

# ---------------------------------------------------------------
# Banco PostgreSQL usado pela aplicacao (perfil default)
#   Local (docker compose): jdbc:postgresql://localhost:5433/mercadoexpress
#   Render Postgres.......: jdbc:postgresql://<host-interno>:5432/<banco>
#   Neon..................: jdbc:postgresql://<host>.neon.tech/<banco>?sslmode=require
# ---------------------------------------------------------------
DB_URL=
DB_USER=
DB_PASSWORD=

# Perfil ativo: vazio = PostgreSQL | dev = H2 em memoria
SPRING_PROFILES_ACTIVE=

# Porta HTTP da aplicacao
PORT=8080

# Administrador criado no primeiro startup (se nao existir)
ADMIN_EMAIL=admin@mercado.com
ADMIN_PASSWORD=

# ---------------------------------------------------------------
# Somente docker compose: credenciais do Postgres LOCAL descartavel
# ---------------------------------------------------------------
POSTGRES_DB=mercadoexpress
POSTGRES_USER=mercado
POSTGRES_PASSWORD=
POSTGRES_PORT=5433
